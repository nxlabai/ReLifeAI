# ─────────────────────────────────────────────
# Re:Life AI 환경변수 예시 – 복사해서 .env.local 로 저장하세요.
# .env.local 은 Git 에 커밋되지 않습니다. 실제 키를 이 파일에 적지 마세요.
# ─────────────────────────────────────────────

# [필수 – 실제 AI 리서치] Liner Deep Research Agent API 키 (서버 전용, 브라우저로 전달되지 않음)
# 발급: https://platform.liner.com
LINER_API_KEY=

# [선택 – 로그인/저장] Supabase 프로젝트 설정 > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용: 회원 탈퇴, 관리자 집계에만 사용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# [선택] 배포 주소 (로그인 메일 리다이렉트 확인용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [선택] 비용 관리
# 사용자별 하루 실제 리서치 횟수 (기본 3)
RESEARCH_DAILY_LIMIT=3
# 같은 조건 리서치 결과 재사용 시간(시간 단위, 기본 168 = 7일, 0 이면 캐시 끔)
RESEARCH_CACHE_HOURS=168
# 리서치 1회 서버 실행 예산(초). route maxDuration(300)보다 작아야 함
RESEARCH_MAX_SECONDS=285
# Supabase 를 설정했지만 비로그인 사용자도 실제 리서치를 허용할지 (기본 false)
ALLOW_GUEST_RESEARCH=false

# [개발 전용] 로컬 모의 Liner 서버 (npm run mock:liner). production 에서는 무시됨
# LINER_MOCK_URL=http://127.0.0.1:4010/api/v1/agents/deep-research
